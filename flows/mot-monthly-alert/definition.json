{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Month",
        "interval": 1,
        "schedule": {
          "hours": ["8"],
          "minutes": [0],
          "monthDays": [1]
        },
        "startTime": "2024-01-01T08:00:00",
        "timeZone": "GMT Standard Time"
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Get_Items_-_Vehicles_MOT_Due": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems"
        },
        "parameters": {
          "dataset": "https://jaxplumbinggy.sharepoint.com/sites/JaxPlumbingCRMHub-Live",
          "table": "Vehicles",
          "$filter": "MOTDueDate le '@{formatDateTime(addDays(utcNow(), 30), 'yyyy-MM-dd')}' and MOTDueDate ne null",
          "$orderby": "MOTDueDate asc",
          "$top": 999
        }
      },
      "runAfter": {}
    },
    "Condition_-_Vehicles_Due": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(body('Get_Items_-_Vehicles_MOT_Due')?['value'])",
          0
        ]
      },
      "actions": {
        "Create_Table_-_MOT_Summary": {
          "type": "Table",
          "inputs": {
            "format": "HTML",
            "from": "@body('Get_Items_-_Vehicles_MOT_Due')?['value']",
            "columns": [
              { "header": "Registration", "value": "@item()?['Title']" },
              { "header": "Driver", "value": "@item()?['Driver']?['Value']" },
              { "header": "Make", "value": "@item()?['Make']" },
              { "header": "Model", "value": "@item()?['Model']" },
              { "header": "MOT Due Date", "value": "@{formatDateTime(item()?['MOTDueDate'], 'dd/MM/yyyy')}" }
            ]
          },
          "runAfter": {}
        },
        "Send_Email_-_MOT_Alert": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2"
            },
            "parameters": {
              "emailMessage/To": "data@jaxplumbing.co.uk",
              "emailMessage/Subject": "@{concat('MOT Alert — ', string(length(body('Get_Items_-_Vehicles_MOT_Due')?['value'])), ' vehicle(s) due within 30 days')}",
              "emailMessage/Body": "<p>The following @{string(length(body('Get_Items_-_Vehicles_MOT_Due')?['value']))} vehicle(s) have an MOT due on or before <strong>@{formatDateTime(addDays(utcNow(), 30), 'dd/MM/yyyy')}</strong>:</p>\n@{body('Create_Table_-_MOT_Summary')}\n<p>Please ensure all MOTs are booked in advance.</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {
            "Create_Table_-_MOT_Summary": ["Succeeded"]
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Get_Items_-_Vehicles_MOT_Due": ["Succeeded"]
      }
    }
  },
  "outputs": {}
}
